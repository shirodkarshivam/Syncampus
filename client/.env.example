# SyncCampus Client Environment Variables Template
# For local development with Vite dev server proxy, VITE_API_URL can be left empty.
# For production (e.g. Vercel deployment), set this to your hosted backend URL.

# Backend API Base URL (e.g., https://syncampus-backend.onrender.com)
VITE_API_URL=https://syncampus-backend.onrender.com

# Backend Real-time Gateway URL (Socket.IO endpoint, same as backend service)
VITE_BACKEND_URL=https://syncampus-backend.onrender.com

# Authentication Mode Flag (Keep false for academic demo/deployment phase)
VITE_AUTH_ENABLED=false
