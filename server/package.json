{
  "name": "syncampus-server",
  "version": "1.0.0",
  "description": "SyncCampus Backend API & Database Service",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node ./node_modules/typescript/bin/tsc && node scripts/copyData.js",
    "start": "node dist/server.js",
    "db:generate": "node ./node_modules/prisma/build/index.js generate",
    "db:push": "node ./node_modules/prisma/build/index.js db push",
    "db:migrate": "node ./node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node ./node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:verify": "tsx src/utils/verifyDatabase.ts",
    "test:auth": "tsx scripts/testAuth.ts",
    "test:otp": "tsx scripts/testOtpAndAuth.ts",
    "test:timetable": "tsx scripts/testTimetable.ts",
    "test:realtime": "tsx scripts/testPart5Realtime.ts",
    "test:database": "tsx scripts/testPart6Database.ts",
    "test:all": "tsx scripts/testAuth.ts && tsx scripts/testOtpAndAuth.ts && tsx scripts/testTimetable.ts && tsx scripts/testPart5Realtime.ts && tsx scripts/testPart6Database.ts"
  },
  "keywords": [
    "syncampus",
    "backend",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "SyncCampus Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.20.0",
    "socket.io": "^4.8.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.7.4",
    "socket.io-client": "^4.8.4"
  }
}
