# SyncCampus Backend Environment Variables Template
# Copy this file to .env and configure your local or production settings.

# Server Configuration
PORT=5000
NODE_ENV=production

# PostgreSQL Connection String (Hosted database, e.g. Neon, Supabase, AWS RDS, Render Postgres)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://username:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication Flag (Keep false for academic testing & deployment phase)
AUTH_ENABLED=false

# Allowed CORS Origins / Deployed Frontend URLs (comma-separated if multiple)
FRONTEND_URL=https://syncampus.vercel.app,http://localhost:5173
CORS_ORIGIN=https://syncampus.vercel.app

# JWT Secrets & Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
