# SyncCampus Backend Environment Variables Template
# Copy this file to .env and configure your local settings.

# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres:password@localhost:5432/syncampus?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/syncampus?schema=public"

# JWT Secrets & Expiration
# In production, use strong, cryptographically generated random strings (e.g. openssl rand -hex 32)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_here

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing Cost Factor (10-12 recommended)
BCRYPT_ROUNDS=12

# Allowed CORS Origin for Client Application
CORS_ORIGIN=http://localhost:5173
