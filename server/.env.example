# SyncCampus Backend Environment Variables Template
# Copy this file to .env and configure your PostgreSQL database connection.

# Server Port
PORT=5000

# Environment Mode (development | production | test)
NODE_ENV=development

# PostgreSQL Connection String (Transaction Pooled URL for Supabase/Neon, or standard PostgreSQL URL)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:password@localhost:5432/syncampus?schema=public"

# Direct PostgreSQL Connection URL (Used by Prisma for migrations when connection pooling is enabled)
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://postgres:password@localhost:5432/syncampus?schema=public"
